{
  "name": "op-run-mcp",
  "version": "0.1.0",
  "description": "MCP server that runs commands with 1Password secrets injected as environment variables, without ever showing the values to the agent.",
  "type": "module",
  "bin": {
    "op-run-mcp": "src/index.mjs"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "start": "node src/index.mjs"
  },
  "keywords": [
    "mcp",
    "1password",
    "secrets",
    "claude-code",
    "codex",
    "ai-agents"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luizferw/op-run-mcp.git"
  },
  "dependencies": {
    "@1password/sdk": "0.5.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  }
}
